# Sonatype Nexus MCP Server Configuration

# Mode: readonly | audit | admin
NEXUS_MCP_MODE=readonly

# Source Nexus Instance
NEXUS_URL=http://localhost:8081
NEXUS_USERNAME=
NEXUS_PASSWORD=

NEXUS_VERIFY_TLS=true
NEXUS_TIMEOUT_SECONDS=30
NEXUS_ALLOWED_HOSTS=localhost,127.0.0.1

# Target Nexus Instance (Optional, for environment comparison)
NEXUS_TARGET_URL=
NEXUS_TARGET_USERNAME=
NEXUS_TARGET_PASSWORD=
NEXUS_TARGET_VERIFY_TLS=true

# Logging
NEXUS_LOG_LEVEL=INFO

# Safety & Limits
NEXUS_MCP_ENABLE_RAW_API=false
NEXUS_MCP_RAW_API_GET_ONLY=false
NEXUS_MCP_ENABLE_WRITE_TOOLS=false
NEXUS_MCP_MAX_PAGE_SIZE=100
NEXUS_MCP_MAX_RAW_RESPONSE_BYTES=1048576

# MCP surface (set both to false for tools-only mode behind a multi-instance gateway)
NEXUS_MCP_ENABLE_PROMPTS=true
NEXUS_MCP_ENABLE_RESOURCES=true
